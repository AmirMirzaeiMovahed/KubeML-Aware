{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["mode", "replicaCount", "image", "scheduler", "experiment", "rbac"],
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["production", "reproduction"]
    },
    "replicaCount": {
      "type": "integer",
      "const": 1
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64})$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "scheduler": {
      "type": "object",
      "required": [
        "name",
        "pacingMode",
        "fixedDelaySeconds",
        "expectedCount",
        "targetNode",
        "resultsPath"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "pacingMode": {
          "type": "string",
          "enum": ["none", "fixed", "adaptive"]
        },
        "fixedDelaySeconds": {"type": "number", "minimum": 0},
        "cpuThreshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "maxWaitSeconds": {"type": "number", "exclusiveMinimum": 0},
        "metricsMaxAgeSeconds": {"type": "number", "exclusiveMinimum": 0},
        "adaptiveHysteresis": {"type": "number", "minimum": 0, "maximum": 1},
        "expectedCount": {"type": "integer", "minimum": 0},
        "quietPeriodSeconds": {"type": "number", "exclusiveMinimum": 0},
        "burstTimeoutSeconds": {"type": "number", "exclusiveMinimum": 0},
        "executionTimeoutSeconds": {"type": "number", "exclusiveMinimum": 0},
        "apiTimeoutSeconds": {"type": "number", "exclusiveMinimum": 0},
        "apiRetries": {"type": "integer", "minimum": 0},
        "targetNode": {"type": "string"},
        "reverse": {"type": "boolean"},
        "resultsPath": {"type": "string", "minLength": 1}
      }
    },
    "experiment": {
      "type": "object",
      "required": ["runId", "scenario", "config", "repetition"],
      "properties": {
        "runId": {"type": "string"},
        "scenario": {"type": "string"},
        "config": {"type": "string"},
        "repetition": {"type": "string"}
      }
    },
    "rbac": {
      "type": "object",
      "required": ["create", "nodeMetricsRead"],
      "properties": {
        "create": {"type": "boolean"},
        "nodeMetricsRead": {"type": "boolean"}
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "additionalIngressNamespaceSelectors", "egress"],
      "properties": {
        "enabled": {"type": "boolean"},
        "additionalIngressNamespaceSelectors": {
          "type": "array",
          "items": {"type": "object"}
        },
        "egress": {
          "type": "object",
          "required": ["enabled", "apiServerCIDRs", "apiServerPorts"],
          "properties": {
            "enabled": {"type": "boolean"},
            "apiServerCIDRs": {
              "type": "array",
              "items": {"type": "string", "minLength": 3},
              "uniqueItems": true
            },
            "apiServerPorts": {
              "type": "array",
              "items": {"type": "integer", "minimum": 1, "maximum": 65535},
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "required": ["type", "port", "publishNotReadyAddresses", "annotations"],
      "properties": {
        "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "publishNotReadyAddresses": {"type": "boolean"},
        "annotations": {"type": "object"}
      },
      "additionalProperties": false
    },
    "persistence": {
      "type": "object",
      "required": ["enabled", "existingClaim", "storageClass", "accessModes", "size", "annotations"],
      "properties": {
        "enabled": {"type": "boolean"},
        "existingClaim": {"type": "string"},
        "storageClass": {"type": "string"},
        "accessModes": {
          "type": "array",
          "items": {"type": "string", "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "size": {"type": "string", "minLength": 1},
        "annotations": {"type": "object"}
      },
      "additionalProperties": false
    },
    "podDisruptionBudget": {
      "type": "object",
      "required": ["enabled", "minAvailable"],
      "properties": {
        "enabled": {"type": "boolean"},
        "minAvailable": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "string", "pattern": "^[0-9]+%$"}
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
